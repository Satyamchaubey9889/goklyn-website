# Server
PORT=5000
NODE_ENV=development

# Allowed origin(s) for CORS - your frontend URL(s), comma separated
# e.g. http://localhost:3000,https://goklyn.in,https://www.goklyn.in
CLIENT_URL=http://localhost:3000

# MongoDB
# Local example:        mongodb://127.0.0.1:27017/goklyn
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goklyn?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/goklyn

# Mail (SMTP) settings - used by Nodemailer to send the admin notification
# Works with any SMTP provider (Gmail, Zoho Mail, Outlook/Office365, GoDaddy, Hostinger, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Who receives the "New Contact Form Submission" notification
ADMIN_EMAIL=contact@goklyn.in

# "From" address used when sending mail. Many providers require this to match SMTP_USER.
MAIL_FROM="Goklyn" <no-reply@goklyn.in>
